# Resolves $ANDAMENTO_ROOT to the andamento worktree via a symlink in this
# zellij worktree. Run something like:
#   ln -sfn ~/dev/zellij-scratch.native-tabs andamento
# from this directory once.
export ANDAMENTO_ROOT=$PWD/andamento

if [ ! -d "$ANDAMENTO_ROOT" ]; then
    echo "warning: $PWD/andamento is missing — create the symlink:" >&2
    echo "         ln -sfn <path-to-andamento-worktree> andamento" >&2
fi
