# Resolves $ANDAMENTO_ROOT to the main andamento worktree via a symlink in
# this zellij worktree. Run this from this directory once:
#   ln -sfn ../andamento andamento
export ANDAMENTO_ROOT=$PWD/andamento

if [ ! -d "$ANDAMENTO_ROOT" ]; then
    echo "warning: $PWD/andamento is missing — create the symlink:" >&2
    echo "         ln -sfn ../andamento andamento" >&2
fi
